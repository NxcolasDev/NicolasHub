# MOCK ONLY: copie para .env, substitua os placeholders e nunca use-os em produção.
POSTGRES_DB=nicolas_hub
POSTGRES_USER=nicolas_hub
POSTGRES_PASSWORD=MOCK_ONLY_replace-this-local-password
JWT_SECRET_KEY=MOCK_ONLY_replace-this-with-a-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_PORT=8000
APP_ENVIRONMENT=development
# Configure apenas os proxies confiáveis do ambiente de execução.
FORWARDED_ALLOW_IPS=127.0.0.1
# Em produção, o cadastro público fica fechado por padrão.
# PUBLIC_REGISTRATION=false
REQUEST_MAX_BYTES=262144
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_LOGIC=60
RATE_LIMIT_AI_ACCOUNT=10
RATE_LIMIT_AI_GLOBAL=60

# Configure somente se a integração AWS SQS estiver habilitada.
AWS_REGION=us-east-1
SQS_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Google Gemini. A chave só é enviada pelo backend; AI_API_KEY é alias legado.
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=20
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Para execução local fora do Compose, use uma URL PostgreSQL real.
DATABASE_URL=postgresql+psycopg://nicolas_hub:MOCK_ONLY_replace-this-local-password@localhost:5432/nicolas_hub
